<mxCell id="title" value="Diagrama de bloques · Sintetizador digital polifónico con LPC1769" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1000" height="34" as="geometry"/></mxCell>
<mxCell id="ctrl" value="Controles" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;fontStyle=1;fontSize=15;strokeWidth=2;dashed=1;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="260" height="400" as="geometry"/></mxCell>
<mxCell id="lpc" value="LPC1769 (placa LPCXpresso, CCLK = 100 MHz)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;fontStyle=1;fontSize=15;strokeWidth=2;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="370" y="40" width="770" height="800" as="geometry"/></mxCell>
<mxCell id="anac" value="Etapa analógica de audio (5 V)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;fontStyle=1;fontSize=15;strokeWidth=2;dashed=1;fillColor=#f1f8f0;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="420" height="575" as="geometry"/></mxCell>
<mxCell id="pc" value="&lt;b&gt;Computadora&lt;/b&gt;&lt;br&gt;Aplicación Python (PySide6):&lt;br&gt;editor de armónicos, instrumentos&lt;br&gt;y perillas del ecualizador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="ttl" value="Adaptador USB-TTL de 3,3 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="keys" value="8 pulsadores&lt;br&gt;notas Do4 a Do5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="wave" value="Pulsador de&lt;br&gt;selección de onda" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="495" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="pots" value="4 potenciómetros de 10 kΩ&lt;br&gt;Attack, Decay, Sustain y Release" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="595" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="note" value="Todas las masas (GND) están unidas.&lt;br&gt;La etapa de audio y la matriz se alimentan con fuentes distintas de la de la placa." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="uart" value="&lt;b&gt;UART0&lt;/b&gt;&lt;br&gt;P0.2 (TXD0) y P0.3 (RXD0)&lt;br&gt;buffer circular y parser de tramas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="100" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="tick" value="&lt;b&gt;SysTick&lt;/b&gt;&lt;br&gt;cada 1 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="215" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="gpio" value="&lt;b&gt;GPIO&lt;/b&gt;&lt;br&gt;P2.0 a P2.7" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="385" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="eint" value="&lt;b&gt;EINT1&lt;/b&gt;&lt;br&gt;P2.11" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="495" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="adc" value="&lt;b&gt;ADC en modo burst&lt;/b&gt;&lt;br&gt;AD0.0, AD0.1, AD0.2 y AD0.4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="595" width="190" height="110" as="geometry"/></mxCell>
<mxCell id="synth" value="&lt;b&gt;CPU: motor de síntesis&lt;/b&gt;&lt;br&gt;&lt;i&gt;(ISR del DMA, prioridad 0)&lt;/i&gt;&lt;br&gt;&lt;br&gt;4 voces: oscilador DDS + envolvente ADSR&lt;br&gt;Mezcla en Q15&lt;br&gt;Ecualizador de 3 bandas (Biquad)&lt;br&gt;Saturación a 10 bits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="230" height="500" as="geometry"/></mxCell>
<mxCell id="tmr2" value="&lt;b&gt;Timer2&lt;/b&gt;&lt;br&gt;una petición cada 400 ns" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="740" y="630" width="130" height="70" as="geometry"/></mxCell>
<mxCell id="dma0" value="&lt;b&gt;GPDMA canal 0&lt;/b&gt;&lt;br&gt;doble buffer de 2 × 64 muestras" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="dac" value="&lt;b&gt;DAC de 10 bits&lt;/b&gt;&lt;br&gt;AOUT (P0.26), Fs = 32 kHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="200" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="fft" value="&lt;b&gt;Loop principal&lt;/b&gt;&lt;br&gt;FFT de 512 puntos (Q15)&lt;br&gt;8 bandas de una octava&lt;br&gt;codificación de la matriz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="190" height="150" as="geometry"/></mxCell>
<mxCell id="dma1" value="&lt;b&gt;GPDMA canal 1&lt;/b&gt;&lt;br&gt;buffer de 4608 B (64 LED)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="620" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="p00" value="&lt;b&gt;GPIO P0.0&lt;/b&gt;&lt;br&gt;línea de datos (DIN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="930" y="750" width="190" height="60" as="geometry"/></mxCell>
<mxCell id="filt" value="&lt;b&gt;Filtro de reconstrucción&lt;/b&gt;&lt;br&gt;Sallen-Key con LM358, fc ≈ 13 kHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="195" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="vol" value="&lt;b&gt;Acople y volumen&lt;/b&gt;&lt;br&gt;1 µF, atenuador de 150 kΩ&lt;br&gt;y potenciómetro de 10 kΩ logarítmico" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="315" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="amp" value="&lt;b&gt;Amplificador LM386&lt;/b&gt;&lt;br&gt;ganancia 20" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="435" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="out" value="&lt;b&gt;Salida&lt;/b&gt;&lt;br&gt;220 µF y 100 Ω por canal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="545" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="jack" value="&lt;b&gt;Jack de 3,5 mm&lt;/b&gt;&lt;br&gt;auriculares" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="655" width="360" height="65" as="geometry"/></mxCell>
